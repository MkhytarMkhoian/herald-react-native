{
  "name": "herald-react-native",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/*",
    "example"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc && tsc -p example",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest && npm test -w herald-example",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "set-version": "node scripts/set-version.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "jest": {
    "projects": [
      {
        "displayName": "packages",
        "testEnvironment": "node",
        "roots": [
          "<rootDir>/packages"
        ],
        "testMatch": [
          "**/__tests__/**/*.test.ts?(x)"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/packages/[^/]+/lib/"
        ],
        "moduleNameMapper": {
          "^@herald-analytics/([^/]+)$": "<rootDir>/packages/$1/src"
        },
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/packages/react/"
        ],
        "transformIgnorePatterns": [
          "/node_modules/(?!react-native-adjust/)"
        ]
      },
      {
        "displayName": "react",
        "preset": "@react-native/jest-preset",
        "roots": [
          "<rootDir>/packages/react"
        ],
        "testMatch": [
          "**/__tests__/**/*.test.ts?(x)"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/packages/[^/]+/lib/"
        ],
        "moduleNameMapper": {
          "^@herald-analytics/([^/]+)$": "<rootDir>/packages/$1/src"
        },
        "transformIgnorePatterns": [
          "/node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-navigation)/)"
        ]
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@react-native/babel-preset": "0.86.3",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  }
}
