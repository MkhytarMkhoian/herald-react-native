{
  "name": "herald-react-native",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/packages"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/packages/[^/]+/lib/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@herald-analytics/([^/]+)$": "<rootDir>/packages/$1/src"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!react-native-adjust/)"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react-native-builder-bob": "^0.43.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
