{
  "name": "@herald-analytics/react",
  "version": "0.0.0",
  "description": "Track Herald events from React Native screens and lists: screen views each time a screen gets focus, impressions when something is really on screen, and taps.",
  "keywords": [
    "analytics",
    "react",
    "react-native",
    "react-navigation",
    "hooks"
  ],
  "homepage": "https://mkhytarmkhoian.github.io/herald-docs/",
  "bugs": "https://github.com/MkhytarMkhoian/herald-react-native/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MkhytarMkhoian/herald-react-native.git",
    "directory": "packages/react"
  },
  "license": "Apache-2.0",
  "author": "Mkhytar Mkhoian",
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bob build",
    "prepack": "bob build"
  },
  "dependencies": {
    "@herald-analytics/core": "^0.0.0"
  },
  "peerDependencies": {
    "@react-navigation/native": "^7.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78.0"
  },
  "devDependencies": {
    "@herald-analytics/testing": "^0.0.0",
    "@react-native/jest-preset": "0.87.1",
    "@react-navigation/native": "7.5.1",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "19.3.0",
    "test-renderer": "^1.0.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
