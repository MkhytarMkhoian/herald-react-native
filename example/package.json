{
  "name": "herald-example",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "export": "expo export --platform ios --platform android --output-dir dist",
    "typecheck": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "@herald-analytics/core": "^1.0.0-beta.1",
    "@herald-analytics/log": "^1.0.0-beta.1",
    "@herald-analytics/react": "^1.0.0-beta.1",
    "expo": "~57.0.29",
    "expo-constants": "~57.0.22",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.27",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@herald-analytics/testing": "^1.0.0-beta.1",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.15",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@herald-analytics/react/expo-router$": "<rootDir>/../packages/react/src/expo-router.ts",
      "^@herald-analytics/([^/]+)$": "<rootDir>/../packages/$1/src"
    }
  }
}
